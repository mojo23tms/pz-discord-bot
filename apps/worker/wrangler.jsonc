{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pz-discord-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pz-discord-bot",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
